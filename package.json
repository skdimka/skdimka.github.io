{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:scripts": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,astro}\" --allow-empty-input",
    "fix:scripts": "eslint . --fix",
    "fix:style": "stylelint \"**/*.{css,scss,astro}\" --fix --allow-empty-input",
    "prettier": "prettier --write .",
    "lint": "npm run lint:scripts && npm run lint:style && prettier --check .",
    "fix": "npm run fix:scripts && npm run fix:style && npm run prettier",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "latest",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass": "^1.105.2",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "latest"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*.{css,scss,astro}": [
      "stylelint --fix --allow-empty-input"
    ],
    "*.{js,mjs,ts,tsx,astro,css,scss,md,json}": [
      "prettier --write"
    ]
  }
}
